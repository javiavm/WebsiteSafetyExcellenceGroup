# ===========================================
# SEG Server Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# -------------------------------------------
# REQUIRED
# -------------------------------------------

# Anthropic API Key (for Claude AI)
# Get one at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxx

# -------------------------------------------
# OPTIONAL (defaults shown)
# -------------------------------------------

# Server Configuration
PORT=3001
NODE_ENV=development

# Database (relative to server/ directory)
DATABASE_URL=../database/seg.db

# Admin API Key (for admin dashboard)
ADMIN_KEY=your-secure-admin-key

# Site URL (for email links)
SITE_URL=http://localhost:3001

# -------------------------------------------
# GHL WEBHOOKS (for production)
# -------------------------------------------
# Get these from GoHighLevel dashboard
# Settings > Integrations > Webhooks

# Form Submissions
GHL_WEBHOOK_CLIENT=https://services.leadconnectorhq.com/hooks/YOUR_LOCATION_ID/webhook-trigger/YOUR_TRIGGER_ID
GHL_WEBHOOK_CANDIDATE=https://services.leadconnectorhq.com/hooks/YOUR_LOCATION_ID/webhook-trigger/YOUR_TRIGGER_ID
GHL_WEBHOOK_NEWSLETTER=https://services.leadconnectorhq.com/hooks/YOUR_LOCATION_ID/webhook-trigger/YOUR_TRIGGER_ID

# STKY Assessment
GHL_WEBHOOK_STKY=https://services.leadconnectorhq.com/hooks/YOUR_LOCATION_ID/webhook-trigger/YOUR_TRIGGER_ID

# SIF Scorecard (Free tier)
GHL_WEBHOOK_SIF_FREE=https://services.leadconnectorhq.com/hooks/YOUR_LOCATION_ID/webhook-trigger/YOUR_TRIGGER_ID

# SIF Scorecard (Paid tier)
GHL_WEBHOOK_SIF_PAID=https://services.leadconnectorhq.com/hooks/YOUR_LOCATION_ID/webhook-trigger/YOUR_TRIGGER_ID

# -------------------------------------------
# STRIPE (for Pro/Premium subscriptions)
# -------------------------------------------
# Get these from Stripe Dashboard
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_PRO_PRICE_ID=price_xxxxx
STRIPE_PREMIUM_PRICE_ID=price_xxxxx
BASE_URL=http://localhost:3001
